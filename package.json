    "rules/gitleaks.json",
    "rules/LICENSE-gitleaks",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "model-context-protocol", "secrets", "secret-scanning", "api-keys", "gitleaks", "claude", "cursor", "security", "ai-agents"],
  "repository": {
    "type": "git",
